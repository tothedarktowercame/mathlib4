/-- (:var mu) is common to all candidate actions; its ablation cannot alter argmax in any environment -/
noncomputable def canonicalAmbiguityAxis : Axis where
  name := "canonical-ambiguity"
  levels := [0, 1]
  score := fun _ => 0

theorem canonicalAmbiguityAxis_predicted_not_navigable : ¬ canonicalAmbiguityAxis.Navigable :=
  not_navigable_of_constant (fun _ _ => rfl)

/-- action-dependent directed information gain -/
noncomputable def directedEigAxis : Axis where
  name := "directed-eig"
  levels := [0, 1]
  score := fun x => x

theorem directedEigAxis_navigable : directedEigAxis.Navigable := by
  norm_num [Axis.Navigable, Axis.gradientSteps, directedEigAxis]

/-- action-dependent information-gain augmentation -/
noncomputable def infoGainAxis : Axis where
  name := "info-gain"
  levels := [0, 1]
  score := fun x => x

theorem infoGainAxis_navigable : infoGainAxis.Navigable := by
  norm_num [Axis.Navigable, Axis.gradientSteps, infoGainAxis]

/-- action-dependent pragmatic risk -/
noncomputable def klRiskAxis : Axis where
  name := "kl-risk"
  levels := [0, 1]
  score := fun x => x

theorem klRiskAxis_navigable : klRiskAxis.Navigable := by
  norm_num [Axis.Navigable, Axis.gradientSteps, klRiskAxis]

/-- crossed environmental factor manipulating how readily food can be reached without exploration -/
noncomputable def gridScaleAxis : Axis where
  name := "grid-scale"
  levels := [10, 24, 36]
  score := fun x => x

theorem gridScaleAxis_navigable : gridScaleAxis.Navigable := by
  norm_num [Axis.Navigable, Axis.gradientSteps, gridScaleAxis]

