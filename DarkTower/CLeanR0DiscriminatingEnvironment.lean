/-!
# CLean experiments as prospective DarkTower registrations

Generated by `futon6/scripts/clean_to_lean.py` from an experiment-shaped CLean
EDN. The EDN is the authority: axes, arms, complete seed triples, stop rules,
and the total decision function below are all rendered from it.
-/

namespace DarkTower
open CategoryTheory

namespace CLeanProof_r0_discriminating_environment
-- r0-discriminating-environment: Does epistemic-ablation identity fall when exploration becomes valuable?

/-- The iching/CT method tags appearing in this proof's spine. -/
inductive Method where
  | freezeFactorialDesign
  | verifyMechanismPreconditions
  | verifyPositiveControl
  | measureIdentity
  | adjudicate
  deriving DecidableEq, Repr

/-- The pattern-tagged method spine (the informal reading), a BV.seq chain. -/
def spine : BV Method :=
  BV.seq (BV.atom Method.freezeFactorialDesign) (BV.seq (BV.atom Method.verifyMechanismPreconditions) (BV.seq (BV.atom Method.verifyPositiveControl) (BV.seq (BV.atom Method.measureIdentity) (BV.atom Method.adjudicate))))

/-- The proof steps (the comb positions). -/
inductive Stp where
  | e1
  | e2
  | e3
  | e4
  | e5
  deriving DecidableEq, Repr

/-- The direction a still-open typed hole exposes: an outstanding proof. -/
inductive Obligation where
  | proof
  deriving DecidableEq, Repr

/-- The typed-hole interface: each step is a position; a step exposes an
    `Obligation` iff it carries an open hole, else `Empty` (discharged). -/
def holes : TypedHole where
  poly :=
    { A := Stp
      B := fun
        | Stp.e1 => Empty
        | Stp.e2 => Empty
        | Stp.e3 => Obligation
        | Stp.e4 => Empty
        | Stp.e5 => Empty
    }
  satiety := fun
    | Stp.e1 => SatietyGrade.canon
    | Stp.e2 => SatietyGrade.canon
    | Stp.e3 => SatietyGrade.canon
    | Stp.e4 => SatietyGrade.canon
    | Stp.e5 => SatietyGrade.canon

/-- Named results the reduce-to-known steps discharge to. -/
inductive KnownResult where
  | decisionRule
  deriving DecidableEq, Repr

/-- Which steps discharge to a named theorem (carry no open hole). -/
def discharges : Stp -> Option KnownResult
  | Stp.e5 => some KnownResult.decisionRule
  | _ => none

/-- The comb wiring (construct -> consume edges). -/
def wires : List (Stp × Stp) := [(Stp.e1, Stp.e2), (Stp.e2, Stp.e3), (Stp.e3, Stp.e4), (Stp.e4, Stp.e5)]

/-- The readings held together (M-typed-holes copar): informal ∥ formal ∥ executable. -/
inductive Reading where
  | informal
  | formal
  | executable
  deriving DecidableEq, Repr
def readings : BV Reading :=
  BV.copar (BV.atom Reading.informal) (BV.copar (BV.atom Reading.formal) (BV.atom Reading.executable))

-- Self-verifying checks: the experiment pipeline is type-correct and computes.
example : holes.holeType Stp.e1 = Empty := rfl
example : holes.holeType Stp.e2 = Empty := rfl
example : holes.holeType Stp.e3 = Obligation := rfl
example : holes.holeType Stp.e4 = Empty := rfl
example : holes.holeType Stp.e5 = Empty := rfl
example : holes.satiety Stp.e1 = SatietyGrade.canon := rfl
example : holes.satiety Stp.e2 = SatietyGrade.canon := rfl
example : holes.satiety Stp.e3 = SatietyGrade.canon := rfl
example : holes.satiety Stp.e4 = SatietyGrade.canon := rfl
example : holes.satiety Stp.e5 = SatietyGrade.canon := rfl
example : discharges Stp.e5 = some KnownResult.decisionRule := rfl
/-- The spine prefix reassociates by BV structural congruence (well-shaped comb). -/
example : BV.Cong
    (BV.seq (BV.seq (BV.atom Method.freezeFactorialDesign) (BV.atom Method.verifyMechanismPreconditions)) (BV.atom Method.verifyPositiveControl))
    (BV.seq (BV.atom Method.freezeFactorialDesign) (BV.seq (BV.atom Method.verifyMechanismPreconditions) (BV.atom Method.verifyPositiveControl))) :=
  BV.Cong.seq_assoc (BV.atom Method.freezeFactorialDesign) (BV.atom Method.verifyMechanismPreconditions) (BV.atom Method.verifyPositiveControl)
/-- The informal ∥ formal copar reading commutes (one object, its readings). -/
example : BV.Cong (BV.copar (BV.atom Reading.informal) (BV.atom Reading.formal)) (BV.copar (BV.atom Reading.formal) (BV.atom Reading.informal)) :=
  BV.Cong.copar_comm (BV.atom Reading.informal) (BV.atom Reading.formal)

end CLeanProof_r0_discriminating_environment

