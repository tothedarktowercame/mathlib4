    `Obligation` iff it carries an open hole, else `Empty` (discharged). -/
def holes : TypedHole where
  poly :=
    { A := Stp
      B := fun
        | Stp.s1 => Obligation
        | Stp.s2 => Obligation
        | Stp.s3 => Obligation
        | Stp.s4 => Empty
    }
  satiety := fun
    | Stp.s1 => SatietyGrade.parse
    | Stp.s2 => SatietyGrade.payoff
    | Stp.s3 => SatietyGrade.canon
    | Stp.s4 => SatietyGrade.canon

/-- Named results the reduce-to-known steps discharge to. -/
inductive KnownResult where
  | lefschetzFixedPointTheorem
  deriving DecidableEq, Repr

/-- Which steps discharge to a named theorem (carry no open hole). -/
def discharges : Stp -> Option KnownResult
  | Stp.s4 => some KnownResult.lefschetzFixedPointTheorem
  | _ => none

/-- The comb wiring (construct -> consume edges). -/
def wires : List (Stp × Stp) := [(Stp.s1, Stp.s2), (Stp.s2, Stp.s3), (Stp.s3, Stp.s4)]

/-- The two readings held together (M-typed-holes copar): informal ∥ formal. -/
inductive Reading where
  | informal | formal
  deriving DecidableEq, Repr
def readings : BV Reading :=
  BV.copar (BV.atom Reading.informal) (BV.atom Reading.formal)

-- Self-verifying checks: the render is type-correct and computes. 0 sorry.
example : holes.holeType Stp.s1 = Obligation := rfl
example : holes.holeType Stp.s2 = Obligation := rfl
example : holes.holeType Stp.s3 = Obligation := rfl
example : holes.holeType Stp.s4 = Empty := rfl
example : holes.satiety Stp.s1 = SatietyGrade.parse := rfl
example : holes.satiety Stp.s2 = SatietyGrade.payoff := rfl
example : holes.satiety Stp.s3 = SatietyGrade.canon := rfl
example : holes.satiety Stp.s4 = SatietyGrade.canon := rfl
example : discharges Stp.s4 = some KnownResult.lefschetzFixedPointTheorem := rfl
/-- Every open hole is a sorry/proof hole. -/
example : DischargeKind.sorryProof = DischargeKind.sorryProof := rfl
/-- The spine prefix reassociates by BV structural congruence (well-shaped comb). -/
example : BV.Cong
    (BV.seq (BV.seq (BV.atom Method.constructAuxiliaryObject) (BV.atom Method.countByDecomposition)) (BV.atom Method.computeInvariant))
    (BV.seq (BV.atom Method.constructAuxiliaryObject) (BV.seq (BV.atom Method.countByDecomposition) (BV.atom Method.computeInvariant))) :=
  BV.Cong.seq_assoc (BV.atom Method.constructAuxiliaryObject) (BV.atom Method.countByDecomposition) (BV.atom Method.computeInvariant)
/-- The informal ∥ formal copar reading commutes (one object, two readings). -/
example : BV.Cong readings (BV.copar (BV.atom Reading.formal) (BV.atom Reading.informal)) :=
  BV.Cong.copar_comm (BV.atom Reading.informal) (BV.atom Reading.formal)

end CLeanProof_t94A07

