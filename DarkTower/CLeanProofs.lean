namespace CLeanProof_a01A01
-- a01A01: Pringsheim's theorem — nonneg-coefficient power series is singular at its radius

/-- The iching/CT method tags appearing in this proof's spine. -/
inductive Method where
  | argueByContradiction
  | localToGlobal
  | reduceToKnownResult
  deriving DecidableEq, Repr

/-- The pattern-tagged method spine (the informal reading), a BV.seq chain. -/
def spine : BV Method :=
  BV.seq (BV.atom Method.argueByContradiction) (BV.seq (BV.atom Method.localToGlobal) (BV.seq (BV.atom Method.localToGlobal) (BV.atom Method.reduceToKnownResult)))

/-- The proof steps (the comb positions). -/
inductive Stp where
  | s1
  | s2
  | s3
  | s4
  deriving DecidableEq, Repr

/-- The direction a still-open typed hole exposes: an outstanding proof. -/
inductive Obligation where
  | proof
  deriving DecidableEq, Repr

/-- The typed-hole interface: each step is a position; a step exposes an
    `Obligation` iff it carries an open hole, else `Empty` (discharged). -/
def holes : TypedHole where
  poly :=
    { A := Stp
      B := fun
        | Stp.s1 => Empty
        | Stp.s2 => Obligation
        | Stp.s3 => Obligation
        | Stp.s4 => Empty
    }
  satiety := fun
    | Stp.s1 => SatietyGrade.canon
    | Stp.s2 => SatietyGrade.payoff
    | Stp.s3 => SatietyGrade.canon
    | Stp.s4 => SatietyGrade.canon

/-- Named results the reduce-to-known steps discharge to. -/
inductive KnownResult where
  | rootTestRadius
  deriving DecidableEq, Repr

/-- Which steps discharge to a named theorem (carry no open hole). -/
def discharges : Stp -> Option KnownResult
  | Stp.s4 => some KnownResult.rootTestRadius
  | _ => none

/-- The comb wiring (construct -> consume edges). -/
def wires : List (Stp × Stp) := [(Stp.s1, Stp.s2), (Stp.s2, Stp.s3), (Stp.s3, Stp.s4)]

/-- The two readings held together (M-typed-holes copar): informal ∥ formal. -/
inductive Reading where
  | informal | formal
  deriving DecidableEq, Repr
def readings : BV Reading :=
  BV.copar (BV.atom Reading.informal) (BV.atom Reading.formal)

-- Self-verifying checks: the render is type-correct and computes. 0 sorry.
example : holes.holeType Stp.s1 = Empty := rfl
example : holes.holeType Stp.s2 = Obligation := rfl
example : holes.holeType Stp.s3 = Obligation := rfl
example : holes.holeType Stp.s4 = Empty := rfl
example : holes.satiety Stp.s1 = SatietyGrade.canon := rfl
example : holes.satiety Stp.s2 = SatietyGrade.payoff := rfl
example : holes.satiety Stp.s3 = SatietyGrade.canon := rfl
example : holes.satiety Stp.s4 = SatietyGrade.canon := rfl
example : discharges Stp.s4 = some KnownResult.rootTestRadius := rfl
/-- Every open hole is a sorry/proof hole. -/
example : DischargeKind.sorryProof = DischargeKind.sorryProof := rfl
/-- The spine prefix reassociates by BV structural congruence (well-shaped comb). -/
example : BV.Cong
    (BV.seq (BV.seq (BV.atom Method.argueByContradiction) (BV.atom Method.localToGlobal)) (BV.atom Method.localToGlobal))
    (BV.seq (BV.atom Method.argueByContradiction) (BV.seq (BV.atom Method.localToGlobal) (BV.atom Method.localToGlobal))) :=
  BV.Cong.seq_assoc (BV.atom Method.argueByContradiction) (BV.atom Method.localToGlobal) (BV.atom Method.localToGlobal)
/-- The informal ∥ formal copar reading commutes (one object, two readings). -/
example : BV.Cong readings (BV.copar (BV.atom Reading.formal) (BV.atom Reading.informal)) :=
  BV.Cong.copar_comm (BV.atom Reading.informal) (BV.atom Reading.formal)

end CLeanProof_a01A01

