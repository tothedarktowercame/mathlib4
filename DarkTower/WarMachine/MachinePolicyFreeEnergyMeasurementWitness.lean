theorem pinnedCandidateCount : pinnedChannels.length = 145 := by rfl

/-- Each pinned candidate is governed by the registry's symbolic-log law. -/
theorem everyPinnedCandidateUsesMachinePolicyFreeEnergy :
    ∀ xs ∈ pinnedChannels,
      machinePolicyFreeEnergy xs 0 (1 / 100) .floor =
        xs.foldlM (fun total datum =>
          return total + (← channelPolicyFreeEnergy datum 0 (1 / 100) .floor)) 0 := by
  intro xs _
  rfl

#print axioms pinnedCandidateCount
#print axioms everyPinnedCandidateUsesMachinePolicyFreeEnergy

